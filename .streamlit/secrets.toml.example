# Copy to .streamlit/secrets.toml for local work, or paste the same thing into
# Streamlit Cloud → your app → Settings → Secrets. Never commit the real file.

gsheet_id = "PASTE_THE_SHEET_ID"   # from the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit

# Optional. A free Windy webcams key turns the Live webcams panel from a handful of always-on
# streams into the geolocated catalogue, which is what lets it narrow to the selected country.
# Get one at api.windy.com/keys — the free tier is 1,000 calls a day, far more than this uses.
# windy_webcams_key = "..."

# Optional. How this app identifies itself to UN OCHA's humanitarian API. It defaults to the
# project's own contact; set it to "yourapp:you@example.com" if you would rather it were yours.
# hapi_app_identifier = "axn-pulse:you@example.com"

# The Google service account that may write to that sheet. Download its JSON key and copy the
# fields across. Keep the \n escapes in private_key exactly as they appear in the JSON.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "news-monitor@your-project.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""

# Already used by the dashboard to read the monitor's data from GitHub
# GITHUB_DATA_REPO = "ssaidurr/osint_socialmedia"
# GITHUB_TOKEN = "github_pat_..."
