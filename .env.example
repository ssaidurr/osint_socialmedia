# Copy to .env and fill in.

# Optional (free) — Gemini for better Bangla/Banglish sentiment, category and a one-line summary.
# Get a key at https://aistudio.google.com/apikey . Without an LLM key the built-in lexicon analyzer is used.
GEMINI_API_KEY=

# Optional (paid) — Claude instead of Gemini.
ANTHROPIC_API_KEY=

# Optional (free) — enables the YouTube collector (videos + comments).
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> Create API key. Steps in README.
YOUTUBE_API_KEY=

# Required for sending ticket emails.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-character code below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.sender@gmail.com
SMTP_PASSWORD=
# Defaults to SMTP_USER
ALERT_FROM=
